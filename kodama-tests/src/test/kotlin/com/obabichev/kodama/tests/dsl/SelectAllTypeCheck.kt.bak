package com.obabichev.kodama.tests.dsl

import com.obabichev.kodama.tests.schema.Order
import com.obabichev.kodama.tests.schema.Person
import com.obabichev.kodama.tests.schema.generated.from

/**
 * This file tests that accessing non-selected tables results in compile errors.
 * It should NOT compile.
 */
fun testOnlyOrderSelected() {
    val query = from(Person)
        .innerJoin(Order) { order.userName eq person.name }
        .selectAll(Order)  // Only Order selected

    // This should NOT compile:
    // query.execute(tx).forEach { row ->
    //     row.person.name  // ERROR: Person not selected
    // }
}

fun testBothSelected() {
    val query = from(Person)
        .innerJoin(Order) { order.userName eq person.name }
        .selectAll(Person)
        .selectAll(Order)  // Both selected

    // This SHOULD compile:
    // query.execute(tx).forEach { row ->
    //     row.person.name  // OK: Person was selected
    //     row.order.product  // OK: Order was selected
    // }
}
