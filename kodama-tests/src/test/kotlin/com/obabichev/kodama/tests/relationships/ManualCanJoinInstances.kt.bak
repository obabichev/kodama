package com.obabichev.kodama.tests.relationships

import com.obabichev.kodama.query.CanJoin
import com.obabichev.kodama.tests.schema.Person
import com.obabichev.kodama.tests.schema.Order
import com.obabichev.kodama.tests.schema.Profile

/**
 * Manual CanJoin instances for proof-of-concept testing.
 * In production, these will be auto-generated by KSP processor.
 *
 * These instances enable compile-time join validation based on declared relationships:
 * - Person → Order (one-to-many)
 * - Person → Profile (one-to-many)
 * - Order → Person (many-to-one)
 * - Profile → Person (many-to-one)
 */

/**
 * Allows joining from Person to Order.
 * Based on relationship: Person.orders = oneToMany(Order, ...)
 */
object PersonCanJoinOrder : CanJoin<Person, Order>

/**
 * Allows joining from Person to Profile.
 * Based on relationship: Person.profile = oneToMany(Profile, ...)
 */
object PersonCanJoinProfile : CanJoin<Person, Profile>

/**
 * Allows joining from Order to Person.
 * Based on relationship: Order.person = manyToOne(Person, ...)
 */
object OrderCanJoinPerson : CanJoin<Order, Person>

/**
 * Allows joining from Profile to Person.
 * Based on relationship: Profile.person = manyToOne(Person, ...)
 */
object ProfileCanJoinPerson : CanJoin<Profile, Person>
